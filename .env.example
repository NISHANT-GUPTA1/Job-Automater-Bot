# Copy this file to .env and fill in your own values. Never commit .env.

# ---- Telegram ----
# Token from @BotFather (looks like 1234567890:AAE...)
TELEGRAM_BOT_TOKEN=
# Your numeric chat id. Leave empty at first: start the bot, send it /start, and it replies with the number.
TELEGRAM_CHAT_ID=

# ---- AI providers: tried in this order, any one is enough ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Gmail (sending emails + reading verification codes) ----
GMAIL_ADDRESS=
# 16-letter App Password (Google Account > Security > 2-Step Verification > App passwords)
GMAIL_APP_PASSWORD=

# ---- The one login used on every job site ----
# Email for all job-site signups (defaults to GMAIL_ADDRESS)
APPLY_EMAIL=
# Password for all job-site signups. Leave empty and one is generated and written here on first use.
APPLY_PASSWORD=

# ---- Behaviour ----
# false = a visible browser window you can watch and help in
HEADLESS=false
# false = ask on Telegram before the final "Submit application" click
AUTO_SUBMIT=false
# Optional: use your installed browser instead of Playwright's Chromium (chrome or msedge)
BROWSER_CHANNEL=
MAX_STEPS_PER_JOB=30
QUESTION_TIMEOUT_MIN=60

# ---- Resumes ----
# Tailor and recruiter-check the resume for every job
ALWAYS_TAILOR=true
# Minimum ATS keyword match (%) a tailored resume must reach
RESUME_MIN_ATS=85
# related = may add job skills related to your real background; strict = only what your resume says
RESUME_KEYWORD_MODE=related

# ---- Phone control of the bot's browser (/remote) ----
REMOTE_CONTROL=true
REMOTE_PORT=8765
# Set automatically at runtime; only set it yourself if you serve the browser view another way
BROWSER_VIEW_URL=

# ---- Misc ----
# Only used to show costs in rupees as well as dollars
USD_TO_INR=88
# Optional Fernet key for encrypting stored passwords (auto-created in data/secret.key if empty)
SECRET_KEY=

# ---- Prospector (second bot: cold outreach to small companies, see README) ----
# Token of a SECOND bot from @BotFather (the same chat id is used)
PROSPECTOR_TELEGRAM_BOT_TOKEN=
# Apollo.io: Settings > Integrations > API. Free accounts must be registered with a work/college email.
APOLLO_API_KEY=
# Stop using Apollo credits after this many per month
APOLLO_MONTHLY_CREDITS=100
# Hunter.io (free: 25 searches + 50 verifications a month) for named HR / engineering / founder emails
HUNTER_API_KEY=
HUNTER_MONTHLY_SEARCHES=50
HUNTER_MONTHLY_VERIFICATIONS=100
PROSPECT_DAILY_LIMIT=10
PROSPECT_SEND_HOUR=10
PROSPECT_FOLLOWUP_DAYS=5
PROSPECT_CONTACTS_PER_COMPANY=1
PROSPECT_AUTO_DISCOVER=true
# Company headquarters to search (comma separated)
PROSPECT_LOCATIONS=India
# Job titles a company must be hiring for (comma separated)
PROSPECT_ROLES=software engineer,backend engineer,python developer,full stack developer,react developer,ai engineer,machine learning engineer,software engineer intern,backend intern,ai intern,sde intern
